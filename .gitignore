# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# build caches — regenerated by tsc/next, and they churn on every build
*.tsbuildinfo

# production
/build

# env & secrets — NEVER commit these
.env
.env.local
.env.*.local
*.pem

# private data — the dealer's real bank/CRIS files (NEVER commit).
# Bank statements and CRIS reports arrive with machine-generated names, so this
# ignores the file *types* rather than trying to list them. Nothing the repo
# needs is one of these; a fixture that looks like real data belongs inline in
# a test, with fabricated account/terminal numbers.
*.xls
*.xlsx
*.xlsm
*.csv
*.pdf
Daily_Sales_Report*
Transactions_Report*
178229004953986*

# misc
.DS_Store
*.log
npm-debug.log*

# testing
/coverage

# prisma local db data (if using a local volume)
/prisma/data

# database backups (created on the server)
/backups

# editor
.vscode/*
!.vscode/extensions.json
.idea
